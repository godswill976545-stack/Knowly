# Example - copy to .env and fill in
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
PORT=3001

# Clerk (https://dashboard.clerk.com)
# Without CLERK_SECRET_KEY the API rejects any presented session token (401);
# only guest/demo mode works, and no per-user data is stored.
CLERK_SECRET_KEY=sk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# AI providers - Nous Research is primary, Google Gemini is the fallback pool
NOUS_API_KEY=sk-nous-...
NOUS_BASE_URL=https://inference-api.nousresearch.com/v1
NOUS_MODELS=poolside/laguna-s-2.1:free,meituan/longcat-2.5-preview:free
# Comma-separated Google AI Studio keys; requests rotate across healthy keys
GOOGLE_API_KEYS=AIza...
GEMINI_MODELS=gemini-3.6-flash,gemini-2.5-flash,gemini-2.0-flash

# Protects /api/cron/fetch-news (Vercel injects `Authorization: Bearer $CRON_SECRET`
# into its scheduled calls when this is set)
CRON_SECRET=change-me

# Optional: expose truncated upstream AI provider errors in API responses
# while debugging outages. Leave unset in production.
# EXPOSE_PROVIDER_ERRORS=1
