# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL + anon key, from Supabase dashboard → Project Settings → API.
# Leave unset to run the app locally in demo mode (no auth, local data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key for the API routes that need to bypass RLS
# (AI explanation cache, rate-limit logging, admin publish).
# Never expose this in NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Public app URL, used for Open Graph tags and the PWA.
NEXT_PUBLIC_APP_URL=https://moncheck.vercel.app

# ── SMS / WhatsApp OTP ──────────────────────────────────────────────────────
# Phone login needs an SMS provider configured in Supabase Auth (Twilio).
# Supabase sends the 6-digit code itself; nothing to set here.
# WhatsApp OTP: enable only after configuring the WhatsApp sender in Twilio,
# then set this to "1" to show the "Recevoir par WhatsApp" option.
NEXT_PUBLIC_WHATSAPP_OTP_ENABLED=0

# ── AI explanations (optional) ──────────────────────────────────────────────
# Google AI Studio key used to write the plain-French explanations, cached
# once per alert. Without a key, a plain template is used instead.
GOOGLE_API_KEY=
