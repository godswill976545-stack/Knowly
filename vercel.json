{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/sso-callback", "destination": "/api/sso-callback" }
  ],
  "crons": [{ "path": "/api/cron/fetch-news", "schedule": "0 6 * * *" }]
}
